# Generate a NEW database password; no exchange API keys are needed.
POSTGRES_PASSWORD=
PROVIDER=binance_spot
SYMBOLS='["BTCUSDT","ETHUSDT"]'
INTERVALS='["5m","15m"]'
SCAN_SECONDS=60
VOLUME_LOOKBACK=20
VOLUME_THRESHOLD=3
MIN_QUOTE_VOLUME=100000
DASHBOARD_PORT=8066

# Optional historical PDF import (Compose profile: analysis).
# These existing host directories are mounted only by pdf-import.
HEBELTRADER_PDF_DIR=./data/hebeltrader
HEBELTRADER_REPORT_DIR=./reports/hebeltrader
HEBELTRADER_EXPECTED_COUNT=118

# Optional V1.5 historical collector; exported process environment only.
# A token never authorizes network access, provider usage or a subscription by itself.
EODHD_API_TOKEN=

# HEBELTRADER-Detektiv. Default: Hypothesen-Top-3 auf Fixture/EU-Universum.
DETECTIVE_RESEARCH_MODE=fixture
DETECTIVE_ANALYSIS_MODE=hypothesis
DETECTIVE_HYPOTHESIS_NEWS=true
DETECTIVE_RESEARCH_SNAPSHOT=reports/research-v23/snapshot.json
DETECTIVE_RESEARCH_INDEX=reports/research-v24/research-index.db
DETECTIVE_RESEARCH_CACHE_DIR=reports/research-v23/sec-cache
DETECTIVE_LIVE_ALLOW_NETWORK=false
DETECTIVE_LIVE_MAX_REQUESTS=0
DETECTIVE_LIVE_MAX_CANDIDATES=10
DETECTIVE_LIVE_REQUEST_TIMEOUT_SECONDS=10
DETECTIVE_LIVE_MAX_DURATION_SECONDS=120
# Optional HTTP JSON enricher for clue/search-query expansion (no ticker invention).
DETECTIVE_LLM_ENDPOINT=
DETECTIVE_LLM_API_TOKEN=
# Optional OpenFIGI identity export (collector shape) merged into EU hypothesis universe.
DETECTIVE_OPENFIGI_IDENTITIES=
# Separate bearer-like secret for exposing the explicitly enabled live endpoint.
DETECTIVE_LIVE_API_TOKEN=
# Nur für ausdrücklich aktivierte SEC-Abrufe; Anwendung und Kontakt nennen.
SEC_USER_AGENT=
# V3.1 public discovery is opt-in; no subscription or external notification delivery.
DETECTIVE_PUBLIC_ALLOW_NETWORK=false
DETECTIVE_PUBLIC_MAX_REQUESTS=40
DETECTIVE_PUBLIC_ROOT=data/hebeltrader-detective
DETECTIVE_EXTRACTION_MODEL=gpt-4.1-mini-2025-04-14
DETECTIVE_REASONING_MODEL=gpt-4.1-2025-04-14
DETECTIVE_DISCOVERY_FEEDS=["https://www.deraktionaer.de/aktionaer-news.rss"]
# Optional live Stufe 3b (Tavily search + OpenAI interpretation). Never enable without
# an explicit cost approval. Aliases TAVILY_API_KEY / OPENAI_API_KEY also work.
# DETECTIVE_SEARCH_PROVIDER=tavily
# DETECTIVE_SEARCH_API_KEY=
# DETECTIVE_SOURCE_AI_ENABLED=true
# DETECTIVE_SOURCE_AI_API_KEY=
# DETECTIVE_EXTERNAL_API_APPROVED=false
# DETECTIVE_API_MONTHLY_BUDGET_EUR=5
# TAVILY_API_KEY=
# OPENAI_API_KEY=
# Optional writable host-side extension of the central case register (never rank input).
# DETECTIVE_CASE_REGISTER=/writable/docs/hebeltrader-identification-rules.md
